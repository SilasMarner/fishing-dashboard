# ── Required ──────────────────────────────────────────────────────────────────
# Gemini API key for AI fishing analysis — free tier at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...

# ── Alternative: Anthropic / Claude ──────────────────────────────────────────
# To use Claude instead of Gemini:
#   1. Uncomment ANTHROPIC_API_KEY below and fill in your key (https://console.anthropic.com)
#   2. In fish_logger/app.py: swap the Gemini block for the Anthropic block in run_ai_analysis()
#   3. In fish_logger/requirements.txt: uncomment anthropic>=0.40
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Grafana admin password (must be ≥8 chars on Grafana 12+)
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# ── Optional — override data directory paths ──────────────────────────────────
# Directory where fish_log.db is stored (shared between fish-logger and grafana)
FISHING_DATA_DIR=./data

# Prometheus config and data dirs
PROMETHEUS_CONFIG_DIR=./prometheus
PROMETHEUS_DATA_DIR=./prometheus/data

# Grafana data and provisioning dirs
GRAFANA_DATA_DIR=./grafana/data
GRAFANA_PROVISIONING_DIR=./grafana/provisioning

# Grafana admin username (default: admin)
GRAFANA_ADMIN_USER=admin

# How often to regenerate the AI analysis report (hours, default 6)
ANALYSIS_INTERVAL_HOURS=6
