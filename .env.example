# ── AI provider — set to "groq" or "xai" ──────────────────────────────────────
AI_PROVIDER=groq

# Groq (fast, free tier) — https://console.groq.com
GROQ_API_KEY=gsk_...

# xAI / Grok (~25 req/day free tier) — https://console.x.ai
# Set AI_PROVIDER=xai to use Grok instead of Groq
XAI_API_KEY=xai-...

# ── Alternative: Gemini / Google ─────────────────────────────────────────────
# To use Gemini instead of Grok:
#   1. Uncomment GEMINI_API_KEY and fill in your key — get it at https://aistudio.google.com (use AI Studio for free tier)
#   2. In fish_logger/app.py: swap the Grok block for the Gemini block in run_ai_analysis()
#   3. In fish_logger/requirements.txt: uncomment google-genai>=1.0
# GEMINI_API_KEY=AIzaSy...

# ── Anthropic / Claude — handwritten-log import (/import) ─────────────────────
# Used by the Import page to read photos/scans of handwritten logs and turn them
# into fish_log entries (Claude vision). Independent of AI_PROVIDER above — the
# text-analysis report can stay on Groq/xAI while import uses Claude.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...
# Vision model for import (default claude-opus-4-8; sonnet is cheaper/faster)
IMPORT_MODEL=claude-opus-4-8

# ── Import OCR method ─────────────────────────────────────────────────────────
# Default OCR method shown in the /import dropdown:
#   tesseract  — FREE, on-device (no key needed). Best on neat printing.   ← default
#   ocr_space  — FREE, online (api.ocr.space). Set OCR_SPACE_API_KEY or use demo.
#   anthropic  — Claude vision, best for cursive (uses ANTHROPIC_API_KEY credits)
# The free OCR methods structure their text into entries with Groq, so GROQ_API_KEY
# (above) is required for them. Claude vision needs no Groq.
OCR_PROVIDER=tesseract
# Free OCR.space key — register at https://ocr.space/ocrapi (or leave the demo key)
OCR_SPACE_API_KEY=helloworld

# (Optional) To also run the AI *analysis report* on Claude instead of Grok:
#   swap the Grok block for the Anthropic block in run_ai_analysis() in app.py.

# Grafana admin password (must be ≥8 chars on Grafana 12+)
GRAFANA_ADMIN_PASSWORD=changeme_strong_password

# ── Optional — override data directory paths ──────────────────────────────────
# Directory where fish_log.db is stored (shared between fish-logger and grafana)
FISHING_DATA_DIR=./data

# Prometheus config and data dirs
PROMETHEUS_CONFIG_DIR=./prometheus
PROMETHEUS_DATA_DIR=./prometheus/data

# Grafana data and provisioning dirs
GRAFANA_DATA_DIR=./grafana/data
GRAFANA_PROVISIONING_DIR=./grafana/provisioning

# Grafana admin username (default: admin)
GRAFANA_ADMIN_USER=admin

# How often to regenerate the AI analysis report (hours, default 6)
ANALYSIS_INTERVAL_HOURS=6
